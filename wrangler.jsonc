{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fastrack-shop",
  "compatibility_date": "2026-09-25",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "vinext/server/fetch-handler",
  // VAPID_PRIVATE_KEY is NOT here — it's a real secret, set via
  // `wrangler secret put VAPID_PRIVATE_KEY`, never committed to the repo.
  // These two aren't sensitive (the public key is meant to be public; it's
  // sent to every browser as the Push subscription's applicationServerKey).
  "vars": {
    "VAPID_PUBLIC_KEY": "BM07rjoestxvxP0VKuvfHkvTSwp9X3FAhr0uBWzqGSG05L-uI_Lv09xcgBCNUIyHVGvF8vpHVd4qChZe-3kqV04",
    "VAPID_SUBJECT": "mailto:support@fastrack.cloud"
  },
  "routes": [
    { "pattern": "shop.fastrack.cloud", "custom_domain": true }
  ],
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  // Run the Worker close to the Supabase database, so each query is a short hop instead of a long one.
  "placement": { "mode": "smart" },
  "cache": {
    "enabled": true
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "kv_namespaces": [
    {
      "binding": "VINEXT_KV_CACHE",
      "id": "7f468b3a88ce4667801402e1638091fb"
    }
  ]
}
