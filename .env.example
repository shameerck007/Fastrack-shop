NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional: get a free key at stadiamaps.com to show shops/business names,
# POI icons, and building outlines on maps (like Google Maps). Without it,
# NEXT_PUBLIC_MAPTILER_KEY is used if set, else maps fall back to Esri's
# plainer street tiles (no key needed).
NEXT_PUBLIC_STADIAMAPS_KEY=
NEXT_PUBLIC_MAPTILER_KEY=

# Online payment (Saudi Arabia) through Moyasar. Without the two keys, checkout offers Cash on Delivery only.
# Use the TEST keys (pk_test_ / sk_test_) first. In production set them with `wrangler secret put`, never in the code.
MOYASAR_PUBLISHABLE_KEY=
MOYASAR_SECRET_KEY=
# Any long random text; put the same text in Moyasar's dashboard as the webhook secret, and point the webhook at
# https://shop.fastrack.cloud/api/webhooks/moyasar
MOYASAR_WEBHOOK_SECRET=
# Apple Pay: the text of the domain verification file Moyasar gives you (served at /.well-known/apple-developer-merchantid-domain-association).
APPLE_PAY_DOMAIN_FILE=
